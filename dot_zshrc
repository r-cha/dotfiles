# Git
b() {
  local branch="$1"
  [[ -n "$branch" ]] || {
    print -u2 -- "usage: b <branch>"
    return 2
  }

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git switch --track "origin/$branch"
  else
    git switch -c "$branch"
  fi
}
alias s='git status --porcelain'
alias ss='git status'
alias gd='git diff'
alias gds='git diff --staged'
gca() {
  # git commit all
  (( $# )) || {
    print -u2 -- "usage: gca <commit message>"
    return 2
  }
  git add --all && git commit -m "$*"
}
gcap() {
  # git commit all push
  gca "$@" && git push
}
cdr() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 -- "not inside a Git repository"
    return 1
  }
  cd -- "$root"
}
alias cdcode='cd ~/code' # cd to project library

wthi() {
  local branch="$1"
  local common_dir clone existing target

  [[ -n "$branch" ]] || {
    print -u2 -- "usage: wthi <branch>"
    return 2
  }
  git check-ref-format --branch "$branch" >/dev/null || return

  [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] || {
    print -u2 -- "wthi: not inside a Git worktree"
    return 1
  }

  common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || return
  clone="${common_dir:h}"

  # Reuse the checkout if this branch is already active anywhere.
  existing=$(git -C "$clone" worktree list --porcelain |
    awk -v ref="refs/heads/$branch" '
      /^worktree / { path = substr($0, 10) }
      $1 == "branch" && $2 == ref { print path; exit }
    ') || return
  [[ -n "$existing" ]] && {
    cd -- "$existing"
    return
  }

  target="$clone/.worktrees/${branch//\//-}"
  if [[ -e "$target" ]]; then
    cd -- "$target"
    return
  fi

  git -C "$clone" fetch origin "$branch" || return
  mkdir -p -- "${target:h}" || return

  if git -C "$clone" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$clone" worktree add "$target" "$branch" || return
  else
    git -C "$clone" worktree add --track -b "$branch" \
      "$target" "origin/$branch" || return
  fi

  cd -- "$target"
}

wtbye() {
  local worktree git_dir common_dir main

  [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] || {
    print -u2 -- "wtbye: not inside a Git worktree"
    return 1
  }

  worktree=$(git rev-parse --show-toplevel) || return
  git_dir=$(git rev-parse --path-format=absolute --git-dir) || return
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || return

  if [[ "$git_dir" == "$common_dir" ]]; then
    print -u2 -- "wtbye: refusing to remove the main checkout"
    return 1
  fi

  main="${common_dir:h}"
  builtin cd -- "$main" || return
  if ! git -C "$main" worktree remove "$worktree"; then
    builtin cd -- "$worktree" 2>/dev/null
    return 1
  fi

  exit 0
}



# ─────────────────────────────
# Conda / Mamba setup + helpers
# ─────────────────────────────
export CONDA_CHANGEPS1=false
export CONDA_AUTO_ACTIVATE_BASE=false

# Initialize conda if available
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
  . "$HOME/miniconda3/etc/profile.d/conda.sh"
elif command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.zsh hook)"
fi

# Prompt segment: show active env (dim for base, yellow for others)
conda_prompt() {
  local env="${CONDA_DEFAULT_ENV:-${MAMBA_DEFAULT_ENV:-}}"
  [[ -z "$env" ]] && return 0
  if [[ "$env" = "base" ]]; then
    printf ' %%F{8}(base)%%f '
  else
    printf ' %%F{yellow}(%s)%%f ' "$env"
  fi
}

# Detect an env tied to the repo by walking up the directory tree
_conda_env_in_repo() {
  local dir="$PWD" target f
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.conda-env" ]]; then
      IFS= read -r target < "$dir/.conda-env"
      print -r -- "${target//[[:space:]]/}"
      return
    fi
    for f in environment-dev.yml environment-dev.yaml environment.yml environment.yaml; do
      if [[ -f "$dir/$f" ]]; then
        awk '/^[[:space:]]*name:[[:space:]]*/{print $2; exit}' "$dir/$f"
        return
      fi
    done
    dir="${dir:h}"
  done
}

# Auto-activate/deactivate on cd
typeset -g __AUTO_CONDA=""
_auto_activate_conda() {
  local target="$(_conda_env_in_repo 2>/dev/null)"
  local current="${CONDA_DEFAULT_ENV:-${MAMBA_DEFAULT_ENV:-}}"

  if [[ -n "$target" ]]; then
    if [[ "$current" != "$target" ]]; then
      if conda activate "$target" 2>/dev/null; then
        __AUTO_CONDA="$target"
      else
        print -u2 -- "conda: unable to auto-activate '$target'"
        return 1
      fi
    else
      __AUTO_CONDA="$target"
    fi
  else
    if [[ -n "$__AUTO_CONDA" ]]; then
      if [[ "$current" == "$__AUTO_CONDA" ]]; then
        conda deactivate 2>/dev/null || return
      fi
      __AUTO_CONDA=""
    fi
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _auto_activate_conda
_auto_activate_conda  # run once at shell start

# Quick conda helpers
ca()      { conda activate "$@"; }
cdv()     { conda deactivate; }
cnew()    { local n="$1" py="${2:-}"; [[ -z "$n" ]] && { echo "usage: cnew <name> [python_version]"; return 1; }
            local args=(-n "$n"); [[ -n "$py" ]] && args+=(python="$py")
            conda create -y "${args[@]}" && conda activate "$n"; }
crem()    { local n="${1:-$CONDA_DEFAULT_ENV}"; [[ -z "$n" ]] && { echo "no env"; return 1; }
            conda deactivate 2>/dev/null; conda env remove -n "$n"; }
cexport() { local n="${1:-$CONDA_DEFAULT_ENV}"; [[ -z "$n" ]] && { echo "no env"; return 1; }
            conda env export -n "$n" | sed '/^prefix:/d' > environment.yml && echo "wrote environment.yml"; }
cenv()    { local picked; picked=$(conda env list 2>/dev/null |
              awk 'NR>2 && $1!=""{print $1}' |
              fzf --prompt="conda env> ") || return
            [[ -n "$picked" ]] && conda activate "$picked"; }


# Custom prompt
autoload -Uz vcs_info
add-zsh-hook precmd vcs_info
zstyle ':vcs_info:git:*' formats '%b '
setopt PROMPT_SUBST

format_path() {
  local cur=${PWD:t}                               # current folder (blue)
  local git_root prefix repo rel parent

  if git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    prefix=${git_root%/*}/                         # path before repo
    prefix=${prefix/#$HOME/\~}                     # collapse home to ~
    repo=${git_root:t}                             # repo name
    rel=${PWD#$git_root} rel=${rel#/}              # path *inside* repo
    if [[ -z $rel ]]; then                         # at repo root
      printf '%%F{8}%s%%f%%F{blue}%s%%f' "$prefix" "$repo"
    else                                           # somewhere inside repo
      parent=${rel%/*}; [[ $parent == $rel ]] && parent='' || parent="/$parent"
      printf '%%F{8}%s%%f%%F{white}%s%s/%%f%%F{blue}%s%%f' "$prefix" "$repo" "$parent" "$cur"
    fi
  else                                             # not a git repo
    local parent_path=${PWD:h}
    parent_path=${parent_path/#$HOME/\~}           # collapse home to ~
    printf '%%F{8}%s/%%f%%F{8}%s%%f' "$parent_path" "$cur"
  fi
}

typeset -g PROMPT_PATH=""
typeset -g _PROMPT_PATH_PWD=""
_update_prompt_path() {
  [[ "$PWD" == "$_PROMPT_PATH_PWD" ]] && return
  PROMPT_PATH="$(format_path)"
  _PROMPT_PATH_PWD="$PWD"
}
add-zsh-hook precmd _update_prompt_path

NEWLINE=$'\n'
PROMPT='%F{%(?.green.red)}┌%f$(conda_prompt)${PROMPT_PATH}%F{red} ${vcs_info_msg_0_}%f%F{%(?.green.red)}${NEWLINE}└❯%f '
