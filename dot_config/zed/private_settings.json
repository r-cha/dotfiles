{
  // ── General ──────────────────────────────────────────────
  "cli_default_open_behavior": "new_window",
  "buffer_line_height": "comfortable",
  "diff_view_style": "split",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "button": true,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "cursor_blink": false,
  "icon_theme": "Zed (Default)",

  // ── Appearance ───────────────────────────────────────────
  "theme": {
    "mode": "system",
    "light": "Flexoki Light",
    "dark": "Flexoki Dark"
  },
  "buffer_font_size": 14,
  "preferred_line_length": 120,
  "show_whitespaces": "boundary",
  "scrollbar": { "show": "auto" },
  "gutter": {
    "line_numbers": true,
    "code_actions": true,
    "folds": true
  },
  "scroll_beyond_last_line": "off",
  "vertical_scroll_margin": 10,
  "relative_line_numbers": "disabled",
  "confirm_quit": true,
  "tabs": {
    "git_status": true,
    "file_icons": true
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },

  // ── Terminal ─────────────────────────────────────────────
  "terminal": {
    "line_height": "standard",
    "blinking": "on",
    "env": {
      "GIT_EDITOR": "zed --wait"
    }
  },

  // ── Git ──────────────────────────────────────────────────
  "git": {
    "inline_blame": { "enabled": true }
  },

  // ── Formatting ───────────────────────────────────────────
  "format_on_save": "off",
  "formatter": "language_server",

  // ── LSP ──────────────────────────────────────────────────
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace",
            "ignore": ["*"]
          }
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120
        }
      }
    }
  },

  // ── Language-specific ────────────────────────────────────
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ],
      "format_on_save": "on",
      "tab_size": 4
    },
    "Markdown": {
      "soft_wrap": "preferred_line_length"
    }
  },

  // ── Inlay hints (off by default, toggle with keybinding) ─
  "inlay_hints": {
    "enabled": false
  }
}
